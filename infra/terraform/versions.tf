terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.80"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # For a real deployment, store state remotely (S3 + DynamoDB lock), e.g.:
  # backend "s3" { bucket = "..." key = "shortener/terraform.tfstate" region = "..." dynamodb_table = "..." encrypt = true }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project   = var.name
      ManagedBy = "terraform"
    }
  }
}
